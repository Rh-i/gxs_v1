# ---- stm32_framework（integrate.py 添加，可手动调整）------------------------------
# clangd 不会自己去 CMake 构建目录找 compile_commands.json，必须在这里指明；
# 少了它，Cortex-M 的 -mcpu / -mfpu 与系统头全丢，头文件会一路标红。
#   - CompilationDatabase：相对宿主根目录的构建目录（取自 CMakePresets.json 的 binaryDir）
#   - --query-driver **不能**写在这里（会被当成编译器参数，报 drv_unknown_argument），
#     它只能写在启动 clangd 的地方：VS Code 的 clangd.arguments，或命令行参数
# 换预设（例如改看 Release）时改下面第一行，或删掉本段后重跑 integrate.py。
CompileFlags:
  CompilationDatabase: build/Debug
  Add:
    - -Wno-unknown-warning-option

Completion:
  HeaderInsertion: Never


InlayHints:
  Enabled: true
  ParameterNames: false   # show names of parameters at call sites.
  DeducedTypes: true      # show deduced type names when non-obvious (eg, auto).
  Designators: true       # show hints in aggregate initialization.
  BlockEnd: true          # show begging of block as a virtual comment at the end of the block.
  DefaultArguments: true  # show default arguments / values in function calls.
  TypeNameLimit: 25       # character limit for type hints


Diagnostics:
  Suppress:
    # - unused-includes       # too aggressive, generates many spurious warnings.
    - pp_file_not_found     # mitigate Eclipse/clangd limitation, don't report spurious errors
    # - -Wimplicit-function-declaration

---
# ---- stm32_framework（integrate.py 添加）：库的 templates/ 不是编译单元 ----
# 里面的 .hpp / .cpp 只是给宿主抄的样例，不参与构建。若让 clangd 也按工程配置解析它们：
#   - 会冒出一堆假错误（模板没有你的 CubeMX 句柄、也没有宿主的上下文）
#   - 同名文件互相干扰：templates/user/board/board_cfg.hpp 与宿主 user/board/board_cfg.hpp
#     同名，跳转 / 补全容易指到模板那份
# 所以这一段让模板目录：不用宿主的编译数据库、不进后台索引、不报诊断。
# 想临时看模板里的补全/跳转，把这一段注释掉即可（改完 clangd 会自动重载）。
If:
  PathMatch: .*templates/.*
CompileFlags:
  CompilationDatabase: None
Index:
  Background: Skip
Diagnostics:
  Suppress: '*'

---
# ---- 第三方库：CubeMX 的 Drivers/（CMSIS + HAL）与 FreeRTOS ----
# 这些代码不归宿主维护，报错/告警没有意义（交叉工具链的专有选项、HAL 里的写法差异都会刷屏）。
# 所以只屏蔽诊断，**保留编译数据库与后台索引**：跳进 HAL / FreeRTOS 看实现仍然正常。
If:
  PathMatch:
    - .*Drivers/.*
    - .*Middlewares/Third_Party/FreeRTOS/.*
Diagnostics:
  Suppress: '*'

---
# ---- CubeMX 生成的 Core/Inc：不报诊断 ----
# main.h / stm32h7xx_hal_conf.h / gpio.h / tim.h / usart.h / FreeRTOSConfig.h 这些都是
# CubeMX 生成的，下次重新生成会被覆盖，在编辑器里标红没有意义。
# 只屏蔽诊断：编译数据库与索引保留，跳进这些头文件看宏定义仍然正常。
#
# 注意这里**不包含 Core/Src**：那里的 USER CODE 段是宿主自己写的，要保留诊断。
If:
  PathMatch: .*Core/Inc/.*
Diagnostics:
  Suppress: '*'
